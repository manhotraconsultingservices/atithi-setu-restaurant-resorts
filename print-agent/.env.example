# Atithi-Setu Print Agent — configuration
# Copy this file to ".env" (same folder as the agent) and fill in your values.
# Setup.bat writes this file for you, so you normally don't edit it by hand.

# Your server address (leave as-is for the hosted service)
BASE_URL=https://erp.atithi-setu.com

# Your restaurant / tenant id (shown in the app under Kitchen Printers)
RESTAURANT_ID=RESTO-XXXX

# The "Print agent token" from the app: Restaurant -> Kitchen Printers
AGENT_TOKEN=pat_xxxxxxxxxxxxxxxxxxxx

# How often to check for new tickets, in milliseconds. 800 = ~0.4s average wait
# per ticket (near-instant). Do NOT raise this above 1000 — a slower poll only adds
# lag and the agent will clamp it back anyway (set POLL_ALLOW_SLOW=1 to override on a
# genuinely weak network).
POLL_MS=800
