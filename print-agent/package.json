{
  "name": "atithi-setu-print-agent",
  "version": "3.3.0",
  "description": "Atithi-Setu on-prem thermal print agent (KOT + invoice) — USB / network ESC/POS.",
  "type": "module",
  "bin": "agent.mjs",
  "scripts": {
    "start": "node agent.mjs",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/AtithiSetuPrintAgent.exe"
  },
  "pkg": {
    "targets": ["node22-win-x64"],
    "outputPath": "dist"
  }
}
