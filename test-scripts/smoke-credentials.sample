# Smoke-test credentials — TEMPLATE (safe to commit; contains no secrets)
#
# To let the technical suite (and an agent) run non-interactively, copy this
# file to  test-scripts/.env.local  and fill in real values. That path is
# gitignored (.env*) and is NEVER committed.
#
#   cp test-scripts/smoke-credentials.sample test-scripts/.env.local
#   # then edit test-scripts/.env.local
#
# SECURITY:
#   * Prefer a DEDICATED test/owner login with least privilege over your primary
#     owner account, so a leaked test file has a small blast radius.
#   * Do NOT reuse a password that has ever been pasted into a chat/log. Rotate first.
#   * The real shell environment overrides this file, so CI can still inject vars.

# Tenant the suite exercises (self-cleaning test data).
RESTAURANT_ID=RESTO-1003

# Target host. Point at staging/local to avoid touching production.
BASE_URL=https://erp.atithi-setu.com

# Owner login for that tenant.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-me
